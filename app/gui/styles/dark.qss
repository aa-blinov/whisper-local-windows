/* Dark theme. Token placeholders are substituted at load time — see theme.py. */

QWidget {
    background-color: {{color.bg_primary}};
    color: {{color.text_primary}};
    font-family: "{{font.family}}";
    font-size: {{font.size_body}};
}

QMainWindow,
QDialog {
    background-color: {{color.bg_primary}};
}

QLabel {
    background-color: transparent;
    color: {{color.text_primary}};
}

QLabel[role="title"] {
    font-size: {{font.size_title}};
    font-weight: 600;
    color: {{color.text_primary}};
}

QLabel[role="heading"] {
    font-size: {{font.size_heading}};
    font-weight: 600;
    color: {{color.text_primary}};
}

QLabel[role="muted"] {
    color: {{color.text_muted}};
    font-size: {{font.size_small}};
}

QPushButton {
    background-color: {{color.bg_elevated}};
    color: {{color.text_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: {{space.sm}} {{space.md}};
}

QPushButton:hover {
    background-color: {{color.border}};
    border-color: {{color.accent}};
}

QPushButton:pressed {
    background-color: {{color.bg_secondary}};
}

QPushButton[role="primary"] {
    background-color: {{color.accent}};
    color: {{color.text_primary}};
    border: none;
}

QPushButton[role="primary"]:hover {
    background-color: {{color.accent_hover}};
}

QFrame[role="card"] {
    background-color: {{color.bg_secondary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}};
}

QFrame[role="card"][active="true"] {
    border: 1px solid {{color.accent}};
}

QLabel[role="badge"] {
    background-color: {{color.bg_elevated}};
    color: {{color.text_primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: {{space.xs}} {{space.md}};
    font-size: {{font.size_small}};
    font-weight: 500;
}

QLabel[role="pill-active"] {
    background-color: {{color.success}};
    color: {{color.bg_primary}};
    border-radius: {{radius.sm}};
    padding: 2px {{space.sm}};
    font-size: {{font.size_small}};
    font-weight: 600;
}

QLabel[role="pill-active"][state="loading"] {
    background-color: {{color.warning}};
    color: {{color.bg_primary}};
}

#TopBar {
    background-color: {{color.bg_secondary}};
    border-bottom: 1px solid {{color.border}};
}

QLabel[role="section-title"] {
    font-size: {{font.size_heading}};
    font-weight: 600;
    color: {{color.text_primary}};
    background-color: transparent;
}

QLabel[role="status-pill"] {
    border-radius: {{radius.sm}};
    padding: 2px {{space.sm}};
    font-size: {{font.size_small}};
    font-weight: 600;
    background-color: {{color.bg_elevated}};
    color: {{color.text_secondary}};
}

QLabel[role="status-pill"][status="running"] {
    background-color: {{color.success}};
    color: {{color.bg_primary}};
}

QLabel[role="status-pill"][status="stopped"] {
    background-color: {{color.warning}};
    color: {{color.bg_primary}};
}

QLabel[role="status-pill"][status="error"] {
    background-color: {{color.danger}};
    color: {{color.text_primary}};
}

QLabel[role="status-pill"][status="unknown"] {
    background-color: {{color.bg_elevated}};
    color: {{color.text_muted}};
}

QLabel[role="recording-pill"] {
    border-radius: {{radius.sm}};
    padding: 2px {{space.sm}};
    font-size: {{font.size_small}};
    font-weight: 600;
    background-color: {{color.bg_elevated}};
    color: {{color.text_secondary}};
}

QLabel[role="recording-pill"][state="recording"] {
    background-color: {{color.danger}};
    color: {{color.text_primary}};
}

QLabel[role="recording-pill"][state="processing"] {
    background-color: {{color.accent}};
    color: {{color.text_primary}};
}

QLabel[role="recording-pill"][state="model_loading"] {
    background-color: {{color.warning}};
    color: {{color.bg_primary}};
}
