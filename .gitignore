# Backup pyproject.toml created during py2app builds — safety
# net for the temporary ``dependencies`` strip; cleaned up on
# normal exit of the build script but stays around if the build
# is interrupted.
pyproject.toml.bak

# Placeholder file created by setup.py to work around py2app 0.28
# assuming builtin zlib has a physical extension file.
.py2app-zlib-built-in-placeholder

